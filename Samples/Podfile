# Uncomment the next line to define a global platform for your project
workspace 'Examples.xcworkspace'
platform :ios, '12.0'
use_frameworks!

# common pods used in all example modules
def common_pods
pod 'AdswizzSDK', :git => "https://github.com/adswizz/ad-sdk-ios.git"
end

project 'BasicAdStreamExample/BasicAdStreamExample.xcodeproj'
project 'BasicAdStreamExampleObjC/BasicAdStreamExampleObjC.xcodeproj'
project 'BasicAdRequestExample/BasicAdRequestExample.xcodeproj'
project 'BasicAdRequestExampleObjC/BasicAdRequestExampleObjC.xcodeproj'
project 'BasicAdRequestWatchExample/BasicAdRequestWatchExample.xcodeproj'
project 'ExternalPlayerExample/ExternalPlayerExample.xcodeproj'
project 'BasicVideoAdExample/BasicVideoAdExample.xcodeproj'
project 'BasicTrackingPermissionExample/BasicTrackingPermissionExample.xcodeproj'
project 'BasicEmptyAdsExample/BasicEmptyAdsExample.xcodeproj'
project 'BasicDVRRequestExample/BasicDVRRequestExample.xcodeproj'
project 'BasicSwiftUIClientSideInsertion/BasicSwiftUIClientSideInsertion.xcodeproj'
project 'BasicTVOSExample/BasicTVOSExample.xcodeproj'
project 'BasicPodcastExample/BasicPodcastExample'
project 'BasicAnalyticsExample/BasicAnalyticsExample'

target :BasicAdRequestExample do
  project 'BasicAdRequestExample/BasicAdRequestExample.xcodeproj'
  common_pods

  target 'BasicAdRequestExampleTests' do
    inherit! :search_paths
    common_pods
  end

  target 'BasicAdRequestExampleUITests' do
    inherit! :search_paths
    common_pods
  end
end

target :BasicAdRequestWatchExample do
  project 'BasicAdRequestWatchExample/BasicAdRequestWatchExample.xcodeproj'
  common_pods

  target 'BasicAdRequestWatchExampleTests' do
    inherit! :search_paths
    common_pods
  end

  target 'BasicAdRequestWatchExampleUITests' do
    inherit! :search_paths
    common_pods
  end
end

target 'BasicAdRequestWatch Extension' do
  platform :watchos, '6.1'
  project 'BasicAdRequestWatchExample/BasicAdRequestWatchExample.xcodeproj'
pod 'AdswizzWatchSDK', :git => "https://github.com/adswizz/ad-sdk-ios.git"
end

target :BasicAdRequestExampleObjC do
  project 'BasicAdRequestExampleObjC/BasicAdRequestExampleObjC.xcodeproj'
  common_pods

  target 'BasicAdRequestExampleObjCTests' do
    inherit! :search_paths
    common_pods
  end

  target 'BasicAdRequestExampleObjCUITests' do
    inherit! :search_paths
    common_pods
  end
end

target :BasicAdStreamExample do
  project 'BasicAdStreamExample/BasicAdStreamExample.xcodeproj'
  common_pods

  target 'BasicAdStreamExampleTests' do
    inherit! :search_paths
    common_pods
  end

  target 'BasicAdStreamExampleUITests' do
    inherit! :search_paths
    common_pods
  end
end

target :BasicAdStreamExampleObjC do
  project 'BasicAdStreamExampleObjC/BasicAdStreamExampleObjC.xcodeproj'
  common_pods

  target 'BasicAdStreamExampleObjCTests' do
    inherit! :search_paths
    common_pods
  end

  target 'BasicAdStreamExampleObjCUITests' do
    inherit! :search_paths
    common_pods
  end
end

target :ExternalPlayerExample do
  project 'ExternalPlayerExample/ExternalPlayerExample.xcodeproj'
  common_pods
end

target :BasicVideoAdExample do
  project 'BasicVideoAdExample/BasicVideoAdExample.xcodeproj'
  common_pods
end

target :BasicTrackingPermissionExample do
  project 'BasicTrackingPermissionExample/BasicTrackingPermissionExample.xcodeproj'
  common_pods
end

target :BasicEmptyAdsExample do
  project 'BasicEmptyAdsExample/BasicEmptyAdsExample.xcodeproj'
  common_pods
end

target :BasicDVRRequestExample do
  project 'BasicDVRRequestExample/BasicDVRRequestExample.xcodeproj'
  common_pods
end

target :BasicSwiftUIClientSideInsertion do
  project 'BasicSwiftUIClientSideInsertion/BasicSwiftUIClientSideInsertion.xcodeproj'
  common_pods
end

target :BasicTVOSExample do
  platform :tvos, '12.0'
  project 'BasicTVOSExample/BasicTVOSExample.xcodeproj'
  common_pods
end

target :BasicPodcastExample do
  project 'BasicPodcastExample/BasicPodcastExample.xcodeproj'
  common_pods
end

target :AdvancedPodcastExample do
  project 'AdvancedPodcastExample/AdvancedPodcastExample.xcodeproj'
  common_pods
  pod 'XCGLogger'
end

target :BasicAnalyticsExample do
  project 'BasicAnalyticsExample/BasicAnalyticsExample.xcodeproj'
  common_pods
pod 'AdswizzSDKPinpointAnalytics', :git => "https://github.com/adswizz/ad-sdk-ios.git"
end

post_install do |installer|
     installer.pods_project.targets.each do |target|
          target.build_configurations.each do |config|
            config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "12.0"
          end
     end
 end
